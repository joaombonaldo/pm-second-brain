// .devin/config.json — shared Devin CLI project config for pm-agents (permissions only).
// Committed to git: NO secrets here (D17 in docs/HANDOFF.md).
// MCP servers live in .devin/mcp_config.json (shared placeholders) and .devin/mcp_config.local.json (yours, git-ignored),
// per https://docs.devin.ai/cli/extensibility/mcp/configuration (Devin CLI v3000.3+).
// Permission rule syntax: check https://docs.devin.ai/cli/extensibility/configuration if Devin rejects a rule.
{
  "permissions": {
    // Reading files is always fine (the brain is plain markdown).
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(ls)",
      "Exec(python3 scripts/validate.py)"
    ],
    // Never run these.
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf)",
      "Exec(git push --force)",
      "Write(**/.env*)"
    ],
    // Always ask first: anything that changes shared repo files, any other shell command,
    // and every MCP call (Jira/Confluence/GitLab writes must be confirmed — D13).
    // UNVERIFIED: whether the "mcp__*" pattern is accepted inside "ask".
    "ask": [
      "Write(AGENTS.md)",
      "Write(.agents/**)",
      "Write(templates/**)",
      "Write(.devin/**)",
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(mv)",
      "Exec(rm)",
      "mcp__*"
    ]
    // Writes inside brain/ use Devin's default (prompt in Normal mode). The skills themselves also ask before
    // durable writes to product/, roadmap/, decisions/ (see AGENTS.md).
  }
}
